# ==============================================================================
# Git Ignore Configuration - Amazon ML Challenge (Team Blacksmith)
# Prevents large data files, caches, models, secrets, and system debris
# ==============================================================================

# --- Large Datasets & Tabular / Columnar Files ---
dataset/
datasets/
data/
output/
outputs/
*.tsv
*.csv
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.npy
*.npz

# --- Intermediate Cache & Working Directories ---
work/cache/
work/pairs/
work/cand/
work/eda/
work/output/
cache/
tmp/
temp/

# --- Model Checkpoints & Large Model Dumps ---
work/models/**/*.txt
checkpoints/
*.pt
*.pth
*.bin
*.onnx
*.pkl
*.pickle
*.joblib
*.model

# --- Large Archives & Compressed Files ---
*.zip
*.tar
*.tar.gz
*.tgz
*.bz2
*.7z
*.rar
*.iso

# --- Confidential Organizer Materials ---
*.pdf
utils/

# --- Secrets, API Tokens & Credentials ---
.env
.env.*
*.pem
*.key
credentials*
secrets*

# --- Python Build & Virtual Environments ---
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
build/
dist/
*.egg-info/

# --- OS & IDE Metadata ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
.vscode/
.idea/
*.swp
*.swo
